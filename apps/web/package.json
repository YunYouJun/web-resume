{
  "name": "@web-resume/web",
  "type": "module",
  "version": "0.4.0",
  "private": true,
  "description": "Create, edit, publish, and export a resume from YAML or JSON Resume data.",
  "author": {
    "url": "https://www.yunyoujun.cn",
    "email": "me@yunyoujun.cn",
    "name": "YunYouJun"
  },
  "homepage": "https://resume.yunle.fun",
  "docs": "https://resume.yunle.fun/docs/",
  "repository": {
    "url": "https://github.com/YunYouJun/web-resume",
    "type": "git"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production vite-ssg build",
    "build:spa": "cross-env NODE_ENV=production vite build",
    "dev": "vite --host --open",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report",
    "e2e:ui": "playwright test --ui",
    "export:pdf": "tsx scripts/export-pdf.ts",
    "migrate:resume": "tsx scripts/migrate-resume.ts",
    "prepare": "rm -f public/schema/resume.schema.json && ln src/assets/schema/resume.schema.json public/schema/resume.schema.json",
    "preview": "vite preview",
    "schema": "tsx scripts/schema.ts",
    "serve": "vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "validate:catalog": "tsx scripts/validate-resume-catalog.ts"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3.8.2",
    "@jsonresume/schema": "~1.3.1",
    "@unhead/vue": "^2.1.17",
    "@unocss/reset": "^66.9.2",
    "@vueuse/core": "^14.4.0",
    "@yunlefun/sso": "^0.6.2",
    "ajv-formats": "^3.0.1",
    "beasties": "^0.3.5",
    "js-yaml": "^5.4.1",
    "monaco-editor": "^0.55.1",
    "monaco-yaml": "5.5.1",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "prism-theme-vars": "^0.2.5",
    "reka-ui": "^2.10.4",
    "sanitize-html": "^2.17.7",
    "sass": "^1.103.1",
    "vue": "^3.5.42",
    "vue-about-me": "^1.4.0",
    "vue-demi": "^0.14.10",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@gtm-support/vue-gtm": "^3.2.0",
    "@headlessui/vue": "^1.7.23",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-yaml": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/node": "^22.20.1",
    "@types/nprogress": "^0.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "ajv": "^8.20.0",
    "consola": "^3.4.2",
    "cross-env": "^10.1.0",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-prism": "^4.0.0",
    "star-markdown-css": "^0.5.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-json-schema": "^0.68.0",
    "unocss": "^66.9.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-markdown": "^29.2.0",
    "unplugin-vue-router": "^0.19.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-ssg": "28.3.0",
    "vite-ssg-sitemap": "^0.10.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
