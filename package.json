{
  "name": "web-resume",
  "type": "module",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "description": "Web 简历",
  "author": {
    "url": "https://www.yunyoujun.cn",
    "email": "me@yunyoujun.cn",
    "name": "YunYouJun"
  },
  "homepage": "https://web-resume.yunyoujun.cn",
  "docs": "https://docs.yunyoujun.cn/projects/web-resume.html",
  "repository": {
    "url": "https://github.com/YunYouJun/web-resume",
    "type": "git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host --open",
    "export:pdf": "tsx scripts/export-pdf.ts",
    "lint": "eslint .",
    "serve": "vite preview",
    "build": "cross-env NODE_ENV=production vite build",
    "build:ssg": "cross-env NODE_ENV=production vite-ssg build",
    "schema": "tsx scripts/schema.ts",
    "prepare": "rm -f public/schema/resume.schema.json && ln src/assets/schema/resume.schema.json public/schema/resume.schema.json && pnpm husky",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "@vueuse/head": "^2.0.0",
    "beasties": "^0.3.5",
    "js-yaml": "^4.1.1",
    "monaco-editor": "^0.55.1",
    "monaco-yaml": "5.1.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "prism-theme-vars": "^0.2.5",
    "reka-ui": "^2.10.4",
    "sass": "^1.96.0",
    "vue": "^3.5.25",
    "vue-about-me": "^1.4.0",
    "vue-demi": "^0.14.10",
    "vue-i18n": "^11.2.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@gtm-support/vue-gtm": "^3.1.0",
    "@headlessui/vue": "^1.7.23",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.6",
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@playwright/test": "^1.57.0",
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it-link-attributes": "^3.0.5",
    "@types/node": "^25.0.1",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.3",
    "ajv": "^8.17.1",
    "consola": "^3.4.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markdown-it-link-attributes": "^4.0.1",
    "markdown-it-prism": "^3.0.1",
    "star-markdown-css": "^0.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-json-schema": "^0.67.1",
    "unocss": "^66.5.10",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "unplugin-vue-markdown": "^29.2.0",
    "unplugin-vue-router": "^0.19.0",
    "vite": "^7.2.7",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vite-plugin-vue-layouts": "^0.11.0",
    "vite-ssg": "25.0.0",
    "vite-ssg-sitemap": "^0.10.0",
    "vitest": "^4.0.15",
    "vue-tsc": "^3.1.8"
  },
  "lint-staged": {
    "*.{vue,ts,js,yml}": "eslint --fix",
    "src/types/*.ts": "npm run schema"
  }
}
