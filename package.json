{
  "name": "web-resume",
  "type": "module",
  "version": "0.4.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "description": "Web 简历 monorepo",
  "author": {
    "url": "https://www.yunyoujun.cn",
    "email": "me@yunyoujun.cn",
    "name": "YunYouJun"
  },
  "homepage": "https://resume.yunle.fun",
  "docs": "https://resume.yunle.fun/docs/",
  "repository": {
    "url": "https://github.com/YunYouJun/web-resume",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/YunYouJun/web-resume/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assemble": "node scripts/assemble-dist.mjs",
    "build": "pnpm build:web && pnpm docs:build && pnpm assemble",
    "build:spa": "pnpm -C apps/web build:spa",
    "build:ssg": "pnpm -C apps/web build",
    "build:web": "pnpm -C apps/web build",
    "dev": "pnpm -C apps/web dev",
    "docs:build": "pnpm -C docs docs:build",
    "docs:dev": "pnpm -C docs docs:dev",
    "docs:preview": "pnpm -C docs docs:preview",
    "e2e": "pnpm -C apps/web e2e",
    "e2e:report": "pnpm -C apps/web e2e:report",
    "e2e:ui": "pnpm -C apps/web e2e:ui",
    "export:pdf": "pnpm -C apps/web exec cross-env WEB_RESUME_CWD=../.. tsx scripts/export-pdf.ts",
    "lint": "eslint .",
    "migrate:resume": "pnpm -C apps/web exec cross-env WEB_RESUME_CWD=../.. tsx scripts/migrate-resume.ts",
    "prepare": "husky",
    "preview": "pnpm -C apps/web exec vite preview --outDir ../../dist",
    "schema": "pnpm -C apps/web schema",
    "serve": "pnpm preview",
    "test": "pnpm -C apps/web test",
    "typecheck": "pnpm -C apps/web typecheck",
    "validate:catalog": "pnpm -C apps/web validate:catalog"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{vue,ts,js,yml}": "eslint --fix",
    "apps/web/src/types/*.ts": "pnpm schema"
  }
}
