{
  "nodeVersion": "24.18.0",
  "installCommand": "npm install --global pnpm@11.25.0 && pnpm install --frozen-lockfile",
  "buildCommand": "VITE_YLF_LOGIN_ENABLED=true VITE_YLF_CLOUD_ENABLED=false pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
